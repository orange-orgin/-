/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 顶部搜索区域 */
.header {
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  padding: 20rpx 30rpx 30rpx;
  position: relative;
  z-index: 100;
}

.search-bar {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #fff;
  border-radius: 36rpx;
  padding: 0 70rpx 0 40rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  font-size: 32rpx;
  opacity: 0.5;
}

.clear-btn {
  position: absolute;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

/* 搜索结果 */
.search-results {
  padding: 20rpx;
}

.search-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.search-title .count {
  color: #FF6347;
  margin-left: 10rpx;
}

.empty-search {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.search-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.item-bottom .price {
  color: #FF6347;
  font-size: 32rpx;
  font-weight: bold;
}

.item-bottom .sales {
  font-size: 24rpx;
  color: #999;
}

/* 轮播公告 */
.notice-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
}

.notice-swiper {
  height: 60rpx;
}

.notice-item {
  line-height: 60rpx;
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分类导航 */
.category-nav {
  background-color: #fff;
  padding: 20rpx 0 20rpx 20rpx;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  height: 150rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 110rpx;
  padding: 10rpx 20rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.category-item.active {
  background-color: #FF634720;
}

.category-item.active .category-name {
  color: #FF6347;
  font-weight: bold;
}

.category-icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.category-name {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  line-height: 1.2;
  white-space: nowrap;
}

/* 商家列表 */
.shop-list {
  padding: 20rpx;
}

.shop-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.shop-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.shop-card.closed {
  opacity: 0.6;
}

.shop-header {
  display: flex;
  align-items: flex-start;
}

.shop-icon {
  font-size: 80rpx;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.shop-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.shop-meta .rating {
  color: #FF9800;
  margin-right: 20rpx;
}

.shop-meta .sales {
  margin-right: 20rpx;
}

.shop-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.shop-status.open {
  background-color: #52c41a20;
  color: #52c41a;
}

.shop-status.closed {
  background-color: #f5f5f5;
  color: #999;
}

.shop-notice {
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #FFF9E6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.notice-label {
  color: #FF9800;
}

.shop-footer {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #999;
}

.delivery-fee {
  margin-right: 30rpx;
}

/* 购物车悬浮按钮 */
.cart-btn {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  z-index: 99;
}

.cart-btn.has-items {
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  background-color: #FF6347;
  color: #fff;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}