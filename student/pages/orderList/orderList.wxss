/* pages/orderList/orderList.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 状态标签 */
.status-tabs {
  display: flex;
  background-color: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.status-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  position: relative;
}

.status-tab.active .tab-text {
  color: #FF6347;
  font-weight: bold;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background-color: #FF6347;
  border-radius: 3rpx;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 订单头部 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.shop-info {
  display: flex;
  align-items: center;
}

.shop-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
}

/* 商品预览 */
.order-goods {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-preview {
  flex: 1;
}

.goods-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.goods-names {
  font-size: 28rpx;
  color: #333;
}

.order-amount {
  margin-left: 30rpx;
}

.order-amount .amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 取餐码 */
.pickup-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.pickup-label {
  font-size: 26rpx;
  color: #666;
}

.pickup-code {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6347;
  letter-spacing: 4rpx;
}

/* 订单底部 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  display: flex;
  align-items: center;
}

.review-btn {
  font-size: 26rpx;
  color: #FF6347;
  margin-right: 20rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FF6347;
  border-radius: 20rpx;
}

.view-detail {
  font-size: 26rpx;
  color: #FF6347;
}