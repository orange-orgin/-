<!-- pages/login/login.wxml -->
<view class="login-container">
  <!-- 顶部背景 -->
  <view class="login-header">
    <view class="logo-area">
      <text class="logo-icon">🍽️</text>
      <text class="logo-text">校园点餐</text>
    </view>
    <text class="slogan">轻松点餐，美味即享</text>
  </view>
  
  <!-- 登录表单 -->
  <view class="login-form">
    <view class="welcome-text">欢迎回来</view>
    <view class="sub-text">登录后即可享受更多服务</view>
    
    <!-- 微信一键登录按钮 -->
    <button 
      class="btn-primary btn-block wx-login-btn" 
      bindtap="getUserProfile"
      hover-class="button-hover"
    >
      <text class="btn-icon">微信</text>
      <text class="btn-text">微信一键登录</text>
    </button>
    
    <!-- 游客模式 -->
    <button 
      class="btn-gray btn-block guest-btn" 
      bindtap="guestLogin"
      hover-class="button-hover"
    >
      游客模式体验
    </button>
    
    <!-- 用户协议 -->
    <view class="agreement">
      <text class="agreement-text">登录即表示同意</text>
      <text class="link">《用户服务协议》</text>
      <text class="agreement-text">和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
  
  <!-- 底部装饰 -->
  <view class="login-footer">
    <view class="footer-item">
      <text class="footer-icon">🏠</text>
      <text class="footer-text">校园食堂</text>
    </view>
    <view class="footer-item">
      <text class="footer-icon">🚀</text>
      <text class="footer-text">快速配送</text>
    </view>
    <view class="footer-item">
      <text class="footer-icon">💝</text>
      <text class="footer-text">专属优惠</text>
    </view>
  </view>
</view>