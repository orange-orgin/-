/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FF6347 0%, #FF7F50 100%);
  display: flex;
  flex-direction: column;
  padding: 0;
}

/* 顶部区域 */
.login-header {
  padding: 120rpx 60rpx 80rpx;
  text-align: center;
  color: #fff;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.slogan {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 登录表单 */
.login-form {
  flex: 1;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 50rpx;
  margin-top: auto;
}

.welcome-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.sub-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

/* 微信登录按钮 */
.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.3);
}

.wx-login-btn .btn-icon {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
}

.button-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 游客按钮 */
.guest-btn {
  background-color: #f5f5f5;
  color: #666;
  height: 88rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 用户协议 */
.agreement {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999;
}

.agreement .link {
  color: #FF6347;
}

/* 底部装饰 */
.login-footer {
  display: flex;
  justify-content: space-around;
  padding: 40rpx;
  background-color: #fff;
}

.footer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}