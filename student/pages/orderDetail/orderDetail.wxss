/* pages/orderDetail/orderDetail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 60rpx;
}

/* 取餐码 */
.pickup-section {
  margin-top: 88rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
  padding: 60rpx 30rpx;
  text-align: center;
}

.pickup-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.pickup-code {
  font-size: 96rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.pickup-hint {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 订单状态 */
.status-section {
  background-color: #fff;
  padding: 30rpx;
}

.status-header {
  display: flex;
  align-items: center;
}

.status-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
}

.status-info {
  flex: 1;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-time {
  font-size: 26rpx;
  color: #999;
}

/* 商家信息 */
.shop-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.shop-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.shop-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

.order-items {
  display: flex;
  flex-direction: column;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-num {
  font-size: 26rpx;
  color: #999;
  margin: 0 30rpx;
}

.item-price {
  font-size: 28rpx;
  color: #333;
}

/* 订单信息 */
.info-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 金额信息 */
.amount-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.amount-row.total {
  border-top: 1rpx solid #eee;
  margin-top: 10rpx;
  padding-top: 20rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 28rpx;
  color: #333;
}

.amount-row.total .amount-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6347;
}

/* 底部操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

.action-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.action-btn.review {
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
}

.action-btn.repeat {
  background-color: #f5f5f5;
  color: #FF6347;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: 28rpx;
  color: #999;
}