/* pages/cart/cart.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 28rpx;
  color: #FF6347;
  padding: 10rpx 20rpx;
}

/* 商家信息 */
.shop-info {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  margin-top: 88rpx;
}

.shop-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shop-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 购物车列表 */
.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.item-price {
  font-size: 28rpx;
  color: #FF6347;
}

.item-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.action-btn.increase {
  background-color: #FF6347;
  color: #fff;
}

.item-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #fff;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.total-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.checkout-btn {
  padding: 20rpx 50rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}