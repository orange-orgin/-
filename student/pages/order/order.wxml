<!-- pages/order/order.wxml -->
<view class="container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="onBack">←</view>
    <text class="nav-title">订单确认</text>
  </view>
  
  <!-- 商家信息 -->
  <view class="shop-section">
    <view class="shop-header">
      <text class="shop-icon">🏪</text>
      <text class="shop-name">{{shopName}}</text>
    </view>
  </view>
  
  <!-- 商品列表 -->
  <view class="goods-section">
    <view class="goods-title">商品清单</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{cart}}" wx:key="id">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill"/>
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-price">¥{{item.price}}</view>
        </view>
        <view class="goods-num">x{{item.num}}</view>
      </view>
    </view>
  </view>
  
  <!-- 备注 -->
  <view class="remark-section">
    <text class="remark-label">备注</text>
    <input 
      class="remark-input" 
      placeholder="口味、偏好等要求（选填）"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="100"
    />
  </view>
  
  <!-- 优惠券 -->
  <view class="coupon-section">
    <view class="coupon-label">优惠券</view>
    <view class="coupon-action" wx:if="{{!hasCoupon}}" bindtap="onUseCoupon">
      <text class="coupon-tip">暂无可用</text>
      <text class="arrow">›</text>
    </view>
    <view class="coupon-action" wx:if="{{hasCoupon}}" bindtap="onCancelCoupon">
      <text class="coupon-value">-¥{{couponDiscount}}</text>
      <text class="coupon-cancel">取消</text>
    </view>
  </view>
  
  <!-- 金额明细 -->
  <view class="amount-section">
    <view class="amount-row">
      <text class="amount-label">商品金额</text>
      <text class="amount-value">¥{{goodsAmount}}</text>
    </view>
    <view class="amount-row">
      <text class="amount-label">配送费</text>
      <text class="amount-value">¥{{deliveryFee}}</text>
    </view>
    <view class="amount-row" wx:if="{{couponDiscount > 0}}">
      <text class="amount-label">优惠券</text>
      <text class="amount-value discount">-¥{{couponDiscount}}</text>
    </view>
    <view class="amount-row total">
      <text class="amount-label">合计</text>
      <text class="amount-value total">¥{{totalAmount}}</text>
    </view>
  </view>
  
  <!-- 底部提交栏 -->
  <view class="submit-bar">
    <view class="submit-info">
      <text class="submit-label">实付款</text>
      <text class="submit-price">¥{{totalAmount}}</text>
    </view>
    <view class="submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="{{canSubmit ? 'onSubmit' : ''}}">
      提交订单
    </view>
  </view>
</view>