/* pages/order/order.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 60rpx;
}

/* 商家信息 */
.shop-section {
  margin-top: 88rpx;
  background-color: #fff;
  padding: 30rpx;
}

.shop-header {
  display: flex;
  align-items: center;
}

.shop-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 商品列表 */
.goods-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.goods-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.goods-list {
  display: flex;
  flex-direction: column;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #FF6347;
}

.goods-num {
  font-size: 28rpx;
  color: #999;
}

/* 备注 */
.remark-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.remark-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 优惠券 */
.coupon-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.coupon-label {
  font-size: 28rpx;
  color: #333;
}

.coupon-action {
  display: flex;
  align-items: center;
}

.coupon-tip {
  font-size: 26rpx;
  color: #999;
}

.coupon-value {
  font-size: 28rpx;
  color: #FF6347;
  font-weight: bold;
}

.coupon-cancel {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}

/* 金额明细 */
.amount-section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.amount-row.total {
  border-top: 1rpx solid #eee;
  margin-top: 10rpx;
  padding-top: 20rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 28rpx;
  color: #333;
}

.amount-value.discount {
  color: #FF6347;
}

.amount-value.total {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6347;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-info {
  display: flex;
  align-items: baseline;
}

.submit-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.submit-price {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6347;
}

.submit-btn {
  padding: 24rpx 60rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.submit-btn.disabled {
  background-color: #ccc;
  pointer-events: none;
}