<!-- pages/mine/mine.wxml -->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-avatar-wrap" bindtap="onLoginTap">
        <image 
          class="user-avatar" 
          src="{{userInfo.avatarUrl || 'https://img.yzcdn.cn/vant/default-avatar.jpg'}}" 
          mode="aspectFill"
        />
        <view class="login-tip" wx:if="{{!userInfo}}">
          <text class="login-text">点击登录</text>
        </view>
      </view>
      <view class="user-info" wx:if="{{userInfo}}">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{userInfo.nickName}}</text>
      </view>
    </view>
  </view>
  
  <!-- 订单入口 -->
  <view class="order-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <view class="view-all" bindtap="onOrderTap" data-status="-1">
        <text>查看全部</text>
        <text class="arrow">›</text>
      </view>
    </view>
    
    <view class="order-tabs">
      <view class="order-tab" bindtap="onOrderTap" data-status="0">
        <text class="tab-icon">⏳</text>
        <text class="tab-text">待接单</text>
        <view class="tab-badge" wx:if="{{orderCounts.pending > 0}}">
          {{orderCounts.pending}}
        </view>
      </view>
      
      <view class="order-tab" bindtap="onOrderTap" data-status="1">
        <text class="tab-icon">🍳</text>
        <text class="tab-text">制作中</text>
        <view class="tab-badge" wx:if="{{orderCounts.making > 0}}">
          {{orderCounts.making}}
        </view>
      </view>
      
      <view class="order-tab" bindtap="onOrderTap" data-status="2">
        <text class="tab-icon">✅</text>
        <text class="tab-text">已完成</text>
        <view class="tab-badge" wx:if="{{orderCounts.completed > 0}}">
          {{orderCounts.completed}}
        </view>
      </view>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-section">
    <view 
      class="menu-item"
      wx:for="{{menuItems}}"
      wx:key="index"
      bindtap="onMenuTap"
      data-index="{{index}}"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-text">{{item.text}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  
  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="onLogout" wx:if="{{userInfo}}">
    退出登录
  </view>
</view>