/* pages/shop/shop.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 顶部商家信息 */
.shop-header {
  position: relative;
  overflow: hidden;
}

.shop-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
}

.shop-content {
  position: relative;
  padding: 60rpx 30rpx 30rpx;
  background-color: #fff;
  border-radius: 0 0 40rpx 40rpx;
  margin: 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
}

.shop-avatar {
  font-size: 120rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.shop-name {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #333;
  margin-bottom: 16rpx;
}

.shop-rating {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.rating-star {
  color: #FF9800;
  margin-right: 20rpx;
}

.rating-text {
  margin-right: 20rpx;
}

.shop-notice {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

/* 菜品列表 */
.dish-section {
  padding: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-item {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.dish-item.out-stock {
  opacity: 0.5;
}

.dish-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dish-sales {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.dish-stock {
  font-size: 22rpx;
  color: #FF6347;
  background-color: #FF634710;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.dish-price .price {
  color: #FF6347;
  font-size: 36rpx;
  font-weight: bold;
}

.dish-price .original-price {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.stock-out {
  padding: 8rpx 20rpx;
  background-color: #ccc;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.dish-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

.action-btn.decrease {
  background-color: #f5f5f5;
  color: #666;
}

.action-btn.increase {
  background-color: #FF6347;
  color: #fff;
}

.dish-count {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  z-index: 100;
}

.cart-bar.empty-bar {
  justify-content: center;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

.cart-info {
  display: flex;
  align-items: center;
}

.cart-icon-wrap {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  font-size: 56rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 36rpx;
  height: 36rpx;
  background-color: #FF6347;
  color: #fff;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-total {
  display: flex;
  flex-direction: column;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.delivery-tip {
  font-size: 22rpx;
  color: #999;
}

.checkout-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 标签切换 */
.tabs {
  display: flex;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab.active {
  background-color: #FF6347;
  color: #fff;
}

/* 评价列表 */
.review-section {
  padding: 20rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
}

.review-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.review-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.rating {
  font-size: 24rpx;
}

.rating text.active {
  color: #FF9800;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background-color: #FF634710;
  color: #FF6347;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.empty-reviews {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 抛物线动画 */
.parabola-item {
  position: fixed;
  width: 60rpx;
  height: 60rpx;
  font-size: 48rpx;
  z-index: 1000;
  pointer-events: none;
  animation: parabola 0.6s ease-out forwards;
}

@keyframes parabola {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(var(--targetX), var(--targetY)) scale(0.5);
    opacity: 0;
  }
}