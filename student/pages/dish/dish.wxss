/* pages/dish/dish.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 60rpx;
}

/* 菜品图片 */
.dish-image-wrap {
  position: relative;
  padding-top: 88rpx;
}

.dish-image {
  width: 100%;
  height: 500rpx;
}

.stock-tag {
  position: absolute;
  top: 120rpx;
  right: 30rpx;
  padding: 10rpx 20rpx;
  background-color: #FF6347;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.stock-tag.out {
  background-color: #999;
}

/* 菜品信息卡片 */
.dish-info-card {
  background-color: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dish-meta .sales {
  font-size: 24rpx;
  color: #999;
  margin-right: 30rpx;
}

.dish-meta .stock {
  font-size: 24rpx;
  color: #666;
}

.dish-price-wrap {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.dish-price-wrap .price {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6347;
}

.dish-price-wrap .original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.dish-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 商家卡片 */
.shop-card {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.shop-icon {
  font-size: 80rpx;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.shop-rating {
  font-size: 24rpx;
  color: #999;
}

.shop-status {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.shop-status.open {
  background-color: #52c41a20;
  color: #52c41a;
}

.shop-status.closed {
  background-color: #f5f5f5;
  color: #999;
}

/* 评价区域 */
.reviews-section {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-reviews {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.review-item {
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
  margin-bottom: 0;
}

.review-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.review-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.review-user .rating text {
  font-size: 20rpx;
}

.review-user .rating text.active {
  opacity: 1;
}

.review-user .rating text:not(.active) {
  opacity: 0.3;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
}

.review-tags .tag {
  padding: 6rpx 16rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 底部购买栏 */
.buy-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.quantity-wrap {
  display: flex;
  align-items: center;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.buy-actions {
  display: flex;
  align-items: center;
}

.add-cart-btn,
.buy-btn {
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

.add-cart-btn {
  background-color: #f5f5f5;
  color: #333;
}

.buy-btn {
  background: linear-gradient(135deg, #FF6347 0%, #FF7F50 100%);
  color: #fff;
}

.add-cart-btn.disabled,
.buy-btn.disabled {
  background-color: #ccc;
  color: #fff;
  pointer-events: none;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: 28rpx;
  color: #999;
}